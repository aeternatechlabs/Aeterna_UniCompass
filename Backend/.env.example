# Backend Environment Variables Template
# Copy this file to .env and configure your production credentials

PORT=3000
NODE_ENV=production

# MongoDB Connection String
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/aeterna?retryWrites=true&w=majority

# Groq AI API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Resend Transactional Email
RESEND_API_KEY=re_your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=admin@aeterna.com

# Allowed Frontend Origins (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173,https://aeternaunicompass.com
